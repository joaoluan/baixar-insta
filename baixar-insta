#!/usr/bin/env python3
"""Baixa todas as fotos e vídeos de um post/reel/carrossel ou perfil público do Instagram via camofox (127.0.0.1:9377).

Uso: baixar-insta <link> [pasta]   (padrão: ~/Downloads/Instagram)
Link de story (instagram.com/stories/usuario) ou destaque (instagram.com/stories/highlights/id) baixa os itens dele.
Links soltos (post, reel, story, destaque) vão para <pasta>/<dono do perfil>, igual ao link de perfil.
Link de perfil (instagram.com/usuario) baixa para <pasta>/usuario, pulando o que já foi baixado:
logado (--login), stories + destaques + todos os posts; sem login, só os 12 posts mais recentes.
Sem link: abre uma janela pedindo o link (é o que o ícone da área de trabalho faz).
baixar-insta --login: abre o Camoufox na tela para entrar numa conta (secundária!) do Instagram;
o login fica salvo em ~/.camofox/profiles e o download de perfil passa a pegar todos os posts.
"""
import glob, json, os, random, re, shutil, subprocess, sys, time, urllib.error, urllib.request, uuid

IS_WIN = os.name == "nt"
API = "http://127.0.0.1:9377"
USER = "baixar-insta"
DEST = os.path.expanduser("~/Downloads/Instagram")
CAMOFOX_DIR = os.environ.get("CAMOFOX_DIR", os.path.expanduser("~/Projetos/camofox-browser"))
POST_LINKS = """[...new Set([...document.querySelectorAll('a')].map(a => a.getAttribute('href'))
  .filter(h => /^\\/([^/]+\\/)?(p|reel)\\/[^/]+\\/?$/.test(h || '')))]"""
HIGHLIGHT_LINKS = """[...new Set([...document.querySelectorAll('a')].map(a => a.getAttribute('href'))
  .filter(h => /^\\/stories\\/highlights\\/\\d+\\/?$/.test(h || '')))]"""
JS = """[...document.querySelectorAll('script[type="application/json"]')]
  .map(s => s.textContent).filter(t => t.includes('image_versions2'))"""


def find_node():
    if IS_WIN:
        prog = os.path.join(os.environ.get("ProgramFiles", r"C:\Program Files"), "nodejs", "node.exe")
        return shutil.which("node") or (prog if os.path.exists(prog) else "node")
    nvm = sorted(glob.glob(os.path.expanduser("~/.nvm/versions/node/*/bin/node")), reverse=True)
    return shutil.which("node") or (nvm[0] if nvm else os.path.expanduser("~/.local/bin/node"))


def api(method, path, body=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(API + path, data=data, method=method, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.load(r)


def ensure_server():
    for i in range(30):
        try:
            api("GET", "/health")
            return
        except urllib.error.HTTPError:
            return  # 503 = servidor no ar com o navegador parado; ele abre ao criar a aba
        except OSError:
            if i == 0:
                if IS_WIN:
                    env = dict(os.environ, CAMOFOX_BIND_HOST="127.0.0.1", CAMOFOX_CRASH_REPORT_ENABLED="false")
                    subprocess.Popen([find_node(), "server.js"], cwd=CAMOFOX_DIR, env=env,
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                     creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
                else:
                    subprocess.run(["systemctl", "--user", "start", "camofox"], check=True)
        time.sleep(1)
    raise RuntimeError("o camofox não respondeu (veja: systemctl --user status camofox)")


def open_tab(url):
    ensure_server()
    for attempt in range(10):
        try:
            return api("POST", "/tabs", {"userId": USER, "sessionKey": uuid.uuid4().hex, "url": url})["tabId"]
        except urllib.error.HTTPError as e:
            if e.code != 503 or attempt == 9:
                raise
            time.sleep(3)  # 503 = navegador reiniciando (o camofox fecha o Firefox ocioso); tenta de novo


def login():
    """Sobe um camofox temporário com janela visível (porta 9378), no mesmo perfil salvo do serviço."""
    port = "9378"
    env = dict(os.environ, CAMOFOX_PORT=port, CAMOFOX_BIND_HOST="127.0.0.1",
               CAMOFOX_CRASH_REPORT_ENABLED="false", CAMOFOX_INTERACTIVE="desktop")
    server = subprocess.Popen([find_node(), "server.js"],
                              cwd=CAMOFOX_DIR, env=env,
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    global API
    main_api, API = API, f"http://127.0.0.1:{port}"
    try:
        for _ in range(30):
            try:
                api("GET", "/health")
                break
            except urllib.error.HTTPError:
                break
            except OSError:
                time.sleep(1)
        api("POST", "/tabs", {"userId": USER, "sessionKey": "login",
                              "url": "https://www.instagram.com/accounts/login/"})
        msg = ("Entre na conta SECUNDÁRIA na janela do Instagram que abriu.\n\n"
               "Quando aparecer o feed, volte aqui e clique OK para salvar o login.")
        if IS_WIN:
            import ctypes
            ctypes.windll.user32.MessageBoxW(0, msg, "Login do Instagram", 0x40)
        else:
            subprocess.run(["zenity", "--info", "--title=Login do Instagram", "--width=420", f"--text={msg}"])
        api("DELETE", f"/sessions/{USER}")  # fechar a sessão grava cookies em ~/.camofox/profiles
    finally:
        API = main_api
        server.terminate()
        server.wait(timeout=30)


def find_media(o):
    """Acha os objetos de mídia (têm image_versions2 + media_type) no JSON embutido na página."""
    if isinstance(o, dict):
        if "image_versions2" in o and "media_type" in o:
            yield o
            return
        for v in o.values():
            yield from find_media(v)
    elif isinstance(o, list):
        for v in o:
            yield from find_media(v)


def media_urls(m):
    """Uma URL por foto/vídeo: vídeo pronto (com áudio) se houver, senão a maior imagem."""
    urls = []
    for item in m.get("carousel_media") or [m]:
        if item.get("video_versions"):
            urls.append((item["video_versions"][0]["url"], ".mp4"))
        else:
            cands = item["image_versions2"]["candidates"]
            urls.append((max(cands, key=lambda c: c.get("width") or 0)["url"], ".jpg"))
    return urls


def profile_name(url):
    m = re.match(r"https://(?:www\.)?instagram\.com/([A-Za-z0-9._]+)/?(?:\?.*)?$", url)
    return m.group(1) if m and m.group(1) not in ("p", "reel", "reels", "explore", "stories", "tv") else None


def download_profile(url, dest, say=print):
    user = profile_name(url)
    dest = os.path.join(dest, user)
    tab = open_tab(url)
    try:
        links = []
        for _ in range(20):
            time.sleep(1)
            links = api("POST", f"/tabs/{tab}/evaluate", {"userId": USER, "expression": POST_LINKS})["result"]
            if links:
                break
        if not links:
            raise RuntimeError("não achei posts nesse perfil: privado, sem posts, ou o Instagram pediu login")
        logged_in = api("POST", f"/tabs/{tab}/evaluate",
                        {"userId": USER, "expression": "document.cookie.includes('ds_user_id')"})["result"]
        highlights = api("POST", f"/tabs/{tab}/evaluate", {"userId": USER, "expression": HIGHLIGHT_LINKS})["result"]
        if logged_in:
            # rola até o fim; a grade só mantém ~40 posts no DOM, então acumula os links a cada rolagem
            idle = 0
            while idle < 3 and done_streak(links, dest) < 12:
                say(f"Lendo o perfil: {len(links)} posts encontrados")
                api("POST", f"/tabs/{tab}/evaluate", {"userId": USER, "expression": "(window.scrollBy(0, 2500), 1)"})
                time.sleep(random.uniform(2.5, 4.5))
                new = [h for h in api("POST", f"/tabs/{tab}/evaluate", {"userId": USER, "expression": POST_LINKS})["result"]
                       if h not in links]
                links += new
                idle = 0 if new else idle + 1
        else:
            say("Sem login: só os 12 posts mais recentes")
    finally:
        api("DELETE", f"/sessions/{USER}")

    saved, failed = [], 0
    if logged_in:  # stories primeiro: somem em 24h
        reels = [f"/stories/{user}/"] + highlights
        for i, href in enumerate(reels):
            say("Baixando stories" if i == 0 else f"Destaque {i} de {len(highlights)}")
            try:
                saved += download_reel("https://www.instagram.com" + href, dest)
            except Exception as e:
                failed += 1
                say(f"falhou {href}: {e}")
            time.sleep(random.uniform(3, 7))

    todo = [h for h in links if not already(h, dest)]
    for i, href in enumerate(todo, 1):
        say(f"Post {i} de {len(todo)}")
        try:
            saved += download("https://www.instagram.com" + href, dest)
        except Exception as e:
            failed += 1
            say(f"falhou {href}: {e}")
        time.sleep(random.uniform(3, 7))  # ritmo de gente, pra conta não ser bloqueada
    return saved, failed, dest, logged_in


def code_of(href):
    return href.rstrip("/").rsplit("/", 1)[-1]


def already(href, dest):
    return bool(glob.glob(os.path.join(glob.escape(dest), glob.escape(code_of(href)) + "*")))


def done_streak(links, dest):
    """Quantos posts seguidos, do fim da lista, já foram baixados (para parar de rolar em perfis já baixados)."""
    n = 0
    for h in reversed(links):
        if not already(h, dest):
            break
        n += 1
    return n


def owner_dir(dest, username, by_owner):
    return os.path.join(dest, username) if by_owner and username else dest


def download(url, dest, by_owner=False):
    tab = open_tab(url)
    try:
        media = None
        for _ in range(20):
            time.sleep(1)
            # código do post pelo endereço final (links /reels/ e de compartilhamento redirecionam)
            here = api("POST", f"/tabs/{tab}/evaluate", {"userId": USER, "expression": "location.href"})["result"]
            want = re.search(r"/(?:p|reels?|tv)/([^/?]+)", here) or re.search(r"/(?:p|reels?|tv)/([^/?]+)", url)
            found = [m for raw in api("POST", f"/tabs/{tab}/evaluate", {"userId": USER, "expression": JS})["result"]
                     for m in find_media(json.loads(raw))]
            # a página logada também traz outros posts no JSON; fica com o do link
            media = next((m for m in found if want and m.get("code") == want.group(1)), found[0] if found else None)
            if media:
                break
    finally:
        api("DELETE", f"/sessions/{USER}")
    if not media:
        raise RuntimeError("não achei mídia nesse link: perfil privado, story, ou o Instagram pediu login")

    dest = owner_dir(dest, (media.get("user") or {}).get("username"), by_owner)
    os.makedirs(dest, exist_ok=True)
    code = media.get("code") or uuid.uuid4().hex[:8]
    urls = media_urls(media)
    saved = []
    for i, (u, ext) in enumerate(urls, 1):
        path = os.path.join(dest, f"{code}_{i:02d}{ext}" if len(urls) > 1 else code + ext)
        urllib.request.urlretrieve(u, path)
        saved.append(path)
    return saved


def find_reels(o):
    """Stories/destaques no JSON da página: dicts com 'items' cujos itens têm image_versions2."""
    if isinstance(o, dict):
        items = o.get("items")
        if isinstance(items, list) and items and isinstance(items[0], dict) and "image_versions2" in items[0]:
            yield o
            return
        for v in o.values():
            yield from find_reels(v)
    elif isinstance(o, list):
        for v in o:
            yield from find_reels(v)


def download_reel(url, dest, by_owner=False):
    """Baixa os itens de um story (/stories/<usuario>/) ou destaque (/stories/highlights/<id>/). Precisa de login."""
    hid = re.search(r"/stories/highlights/(\d+)", url)
    user = None if hid else re.search(r"/stories/([^/?]+)", url).group(1)
    tab = open_tab(url)
    try:
        reel = None
        for _ in range(20):
            time.sleep(1)
            if "/stories/" not in api("POST", f"/tabs/{tab}/evaluate", {"userId": USER, "expression": "location.href"})["result"]:
                return []  # sem story ativo: o Instagram volta pro perfil
            reels = [r for raw in api("POST", f"/tabs/{tab}/evaluate", {"userId": USER, "expression": JS})["result"]
                     for r in find_reels(json.loads(raw))]
            # a página pré-carrega stories de outros perfis; fica só com o do link
            reel = next((r for r in reels if (hid and str(r.get("id")) == f"highlight:{hid.group(1)}")
                         or (user and (r.get("user") or {}).get("username") == user)), None)
            if reel:
                break
    finally:
        api("DELETE", f"/sessions/{USER}")
    if not reel:
        return []

    dest = owner_dir(dest, user or (reel.get("user") or {}).get("username"), by_owner)
    if hid:
        title = re.sub(r"[^\w\- ]", "", reel.get("title") or "").strip() or hid.group(1)
        dest = os.path.join(dest, "destaques", title)
    else:
        dest = os.path.join(dest, "stories")
    os.makedirs(dest, exist_ok=True)
    saved = []
    for item in reel["items"]:
        (u, ext), = media_urls(item)
        path = os.path.join(dest, str(item.get("pk") or item["id"]).split("_")[0] + ext)
        if not os.path.exists(path):
            urllib.request.urlretrieve(u, path)
            saved.append(path)
    return saved


def gui_win():
    import tkinter as tk
    from tkinter import messagebox, simpledialog
    root = tk.Tk(); root.withdraw()
    url = (simpledialog.askstring("Baixar do Instagram", "Cole o link do post, reel ou carrossel:") or "").strip()
    if not url:
        return
    if not re.match(r"https://(www\.)?instagram\.com/", url):
        messagebox.showerror("Baixar do Instagram", "Isso não é um link do Instagram.")
        return
    folder, failed, logged_in = DEST, 0, True
    try:
        if profile_name(url):
            saved, failed, folder, logged_in = download_profile(url, DEST)
        else:
            saved = (download_reel if "/stories/" in url else download)(url, DEST, by_owner=True)
            folder = os.path.dirname(saved[0]) if saved else DEST
    except Exception as e:
        messagebox.showerror("Baixar do Instagram", f"Não consegui baixar:\n{e}")
        return
    text = f"{len(saved)} arquivo(s) novo(s) em {folder}" + (f"\n{failed} post(s) falharam" if failed else "") + (
        "" if logged_in else "\n\nSem login: só os 12 mais recentes. Use o ícone Login Instagram (baixador).")
    if messagebox.askyesno("Pronto", text + "\n\nDeseja abrir a pasta?"):
        os.startfile(folder)


def gui():
    if IS_WIN:
        return gui_win()
    def zenity(*args, **kw):
        return subprocess.run(["zenity", *args], capture_output=True, text=True, **kw)

    r = zenity("--entry", "--title=Baixar do Instagram", "--width=500",
               "--text=Cole o link do post, reel ou carrossel:")
    url = r.stdout.strip()
    if r.returncode != 0 or not url:
        return
    if not re.match(r"https://(www\.)?instagram\.com/", url):
        zenity("--error", "--text=Isso não é um link do Instagram.")
        return
    prog = subprocess.Popen(["zenity", "--progress", "--pulsate", "--no-cancel", "--auto-close",
                             "--title=Baixar do Instagram", "--text=Baixando..."], stdin=subprocess.PIPE, text=True)

    def say(msg):
        prog.stdin.write(f"# {msg}\n"); prog.stdin.flush()

    folder, failed, logged_in = DEST, 0, True
    try:
        if profile_name(url):
            saved, failed, folder, logged_in = download_profile(url, DEST, say)
        else:
            saved = (download_reel if "/stories/" in url else download)(url, DEST, by_owner=True)
            folder = os.path.dirname(saved[0]) if saved else DEST
    except Exception as e:
        prog.stdin.close(); prog.wait()
        zenity("--error", f"--text=Não consegui baixar:\n{e}")
        return
    prog.stdin.close(); prog.wait()
    text = f"{len(saved)} arquivo(s) novo(s) em {folder}" + (f"\n{failed} post(s) falharam" if failed else "") + (
        "" if logged_in else "\n\nSem login: só os 12 mais recentes. Use o ícone Login Instagram (baixador).")
    if zenity("--question", "--title=Pronto", f"--text={text}",
              "--ok-label=Abrir pasta", "--cancel-label=Fechar").returncode == 0:
        subprocess.Popen(["xdg-open", folder])


def main():
    if len(sys.argv) < 2:
        return gui()
    if sys.argv[1] == "--login":
        return login()
    if not re.match(r"https://(www\.)?instagram\.com/", sys.argv[1]):
        sys.exit(__doc__)
    dest = os.path.expanduser(sys.argv[2]) if len(sys.argv) > 2 else DEST
    if profile_name(sys.argv[1]):
        saved, failed, folder, logged_in = download_profile(sys.argv[1], dest)
        print(f"{len(saved)} arquivo(s) novo(s) em {folder}" + (f", {failed} post(s) falharam" if failed else "")
              + ("" if logged_in else " (sem login: só os 12 mais recentes; rode baixar-insta --login)"))
    else:
        for path in (download_reel if "/stories/" in sys.argv[1] else download)(sys.argv[1], dest, by_owner=True):
            print(path)


if __name__ == "__main__":
    main()
